<%- include('../partials/adminhead') %>
<%- include('../partials/loader') %>

<body>

  <!-- admin-Sidebar -->
  <div class="admin-sidebar" id="admin-sidebar">
    <h4 class="text-white mb-4">Border Monitoring</h4>
    <div class="mb-4">
      <i class="bi bi-person-circle me-2"></i><%= full_name %>
    </div>
    <a href="/admin/home"><i class="bi bi-grid"></i> Home</a>
    <a href="/admin/upload"><i class="bi bi-gem"></i> Upload</a>
    <a href="/admin/publish"><i class="bi bi-gem"></i> Publish</a>
    <a href="/admin/manage"><i class="bi bi-person"></i> Manage</a>
    <a href="/admin/update-password" class="active"><i class="bi bi-key"></i> Update Password</a>
    <a href="" id="adminLogout"><i class="bi bi-journal-text"></i> Logout</a>
  </div>

  <!-- Main Content -->
  <div class="content" id="mainContent">
    <div class="themed-box topbar d-flex flex-wrap justify-content-between align-items-center gap-2 themed-box sticky-top">
      <div class="d-flex align-items-center gap-3">
        <i class="bi bi-list fs-3 cursor-pointer" id="toggleSidebarBtn" style="cursor: pointer;"></i>
        <h4 class="mb-0">Update Password</h4>
      </div>
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-bell me-2"></i>
        <i class="bi bi-gear"></i>
      </div>
    </div>

    <main class="main">
      <div class="container-fluid p-4">
        <div class="card border-0 rounded themed-box">

          <div class="card-header">
            <h6 class="card-subtitle text-muted p-3 text-center">
              Change your admin account password
            </h6>
          </div>

          <div class="card border-0 rounded themed-box">
            <form id="updatePasswordForm" class="form p-4" action="" method="post">

              <!-- Current Password -->
              <div class="row mt-3">
                <div class="col-md-12">
                  <div class="form-group">
                    <label for="currentPassword">Current Password <span class="text-danger">*</span></label>
                    <div class="input-group">
                      <input type="password" class="form-control" id="currentPassword" name="currentPassword"
                        placeholder="Enter current password" required autocomplete="current-password" />
                      <button class="btn btn-outline-secondary" type="button" id="toggleCurrentPw" tabindex="-1">
                        <i class="bi bi-eye" id="iconCurrentPw"></i>
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              <!-- New Password -->
              <div class="row mt-3">
                <div class="col-md-12">
                  <div class="form-group">
                    <label for="newPassword">New Password <span class="text-danger">*</span></label>
                    <div class="input-group">
                      <input type="password" class="form-control" id="newPassword" name="newPassword"
                        placeholder="Enter new password" required autocomplete="new-password" />
                      <button class="btn btn-outline-secondary" type="button" id="toggleNewPw" tabindex="-1">
                        <i class="bi bi-eye" id="iconNewPw"></i>
                      </button>
                    </div>
                    <!-- Strength meter (display only) -->
                    <div class="mt-2">
                      <div class="progress" style="height:5px;border-radius:4px;">
                        <div id="strengthBar" class="progress-bar" role="progressbar"
                          style="width:0%;transition:width .3s,background-color .3s;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                      </div>
                      <small id="strengthLabel" class="text-muted mt-1 d-block"></small>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Confirm New Password -->
              <div class="row mt-3">
                <div class="col-md-12">
                  <div class="form-group">
                    <label for="confirmPassword">Confirm New Password <span class="text-danger">*</span></label>
                    <div class="input-group">
                      <input type="password" class="form-control" id="confirmPassword" name="confirmPassword"
                        placeholder="Re-enter new password" required autocomplete="new-password" />
                      <button class="btn btn-outline-secondary" type="button" id="toggleConfirmPw" tabindex="-1">
                        <i class="bi bi-eye" id="iconConfirmPw"></i>
                      </button>
                    </div>
                    <small id="matchLabel" class="mt-1 d-block"></small>
                  </div>
                </div>
              </div>

              <!-- Submit — matches other admin forms exactly -->
              <input type="submit" name="submit" value="updatePassword"
                class="btn px-5 btn-primary mt-4" />

            </form>
          </div>

        </div>
      </div>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/admin-assets/js/handlesubmits.js"></script>

  <!-- UX-only scripts: eye toggles, strength meter, match indicator -->
  <script src="/admin-assets/js/adminUpdatePassword.js"></script>

</body>
</html>
